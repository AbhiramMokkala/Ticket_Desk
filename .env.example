# =================================================================
# TicketDesk Environment Configuration Template
# =================================================================

# Application General
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & JWT (Must match across Java, .NET, and Python)
JWT_SECRET=TicketDeskJwtSecretKeyForVirtusaPOC2026SecureStringMustBe256BitsLong!
JWT_EXPIRATION_HOURS=24
JWT_ISSUER=ticketdesk-auth-service
JWT_AUDIENCE=ticketdesk-platform
INTERNAL_SERVICE_KEY=TicketDeskInternalServiceAuthSecret2026!

# Database Configuration (PostgreSQL 16)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ticketdesk_db
DB_USER=ticketdesk_user
DB_PASSWORD=ticketdesk_secure_password_2026
DATABASE_URL=jdbc:postgresql://postgres:5432/ticketdesk_db
DOTNET_CONNECTION_STRING=Host=postgres;Port=5432;Database=ticketdesk_db;Username=ticketdesk_user;Password=ticketdesk_secure_password_2026
PYTHON_DATABASE_URL=postgresql://ticketdesk_user:ticketdesk_secure_password_2026@postgres:5432/ticketdesk_db

# Microservice Endpoints (Internal Docker Network)
JAVA_SERVICE_URL=http://java-ticket-service:8080
DOTNET_SERVICE_URL=http://dotnet-comment-service:8081
PYTHON_SERVICE_URL=http://python-attachment-service:8082

# Storage Configuration (Local vs AWS S3)
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=/data/attachments
AWS_REGION=us-east-1
S3_ATTACHMENT_BUCKET=ticketdesk-poc-attachments-bucket
# Note: In production EC2, IAM role is used. No AWS keys are committed.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Ports (Host Mappings)
NGINX_PORT=80
FRONTEND_PORT=3000
JAVA_PORT=8080
DOTNET_PORT=8081
PYTHON_PORT=8082
POSTGRES_PORT=5432
