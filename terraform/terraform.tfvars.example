# Example Terraform Variable Configuration for Enterprise POC
# Copy this file to terraform.tfvars and populate with your secure credentials

aws_region           = "us-east-1"
environment          = "poc"
vpc_cidr             = "10.0.0.0/16"
ec2_instance_type    = "t3.small"

# Database Configuration
db_name              = "ticketdesk_db"
db_username          = "ticketdesk_admin"
db_password          = "TicketDesk_SecurePass2026!" # Replace with strong password

# Microservice Security Keys
jwt_secret           = "TicketDeskJwtSecretKeyForEnterprisePOC2026SecureStringMustBe256BitsLong!"
internal_service_key = "TicketDeskInternalServiceAuthSecret2026!"

# Optional: Restrict HTTP/SSH ingress to your personal IP: ["203.0.113.50/32"]
allowed_admin_cidrs  = ["0.0.0.0/0"]

